# ==============================================================================
# QuestionStudio Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit real credentials, live secrets, or production passwords to git.
# ==============================================================================

# Server Environment
PORT=4000
NODE_ENV=production
PUBLIC_APP_URL=https://questions.studio

# Database Connection (PostgreSQL Production)
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=prefer&connection_limit=20
DATABASE_URL="postgresql://qpgen_user:YOUR_STRONG_PASSWORD@postgres:5432/questionstudio_prod?schema=public"

# Application Security Secrets (Generate using: openssl rand -hex 32)
JWT_SECRET="generate-a-unique-64-character-hex-secret-for-jwt-signing"
SESSION_SECRET="generate-a-unique-64-character-hex-secret-for-sessions"

# Razorpay Payment Gateway (Keep TEST credentials until live launch approval)
# Test Mode: Starts with rzp_test_
# Live Mode: Starts with rzp_live_ (Enter ONLY in production deployment secrets vault)
RAZORPAY_KEY_ID="rzp_test_YOUR_TEST_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

# Optional AI Engines
# ANTHROPIC_API_KEY="your-anthropic-key"
# GEMINI_API_KEY="your-gemini-key"
