// Phase 1 — Question Bank Database Schema
// Datasource: SQLite for local/dev (Coolify prod can switch provider to "postgresql" later — same models work unchanged)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Core taxonomy ----------

model Exam {
  id        String     @id @default(cuid())
  name      String     @unique // e.g. "NEET", "JEE", "EAPCET"
  questionMappings QuestionExamMapping[]
  subjects  Subject[]
  createdAt DateTime   @default(now())

  // Exam Hub — a saved "blueprint" for this exam so Generate Paper doesn't
  // need re-typing subject counts / difficulty mix every time.
  patternSubjects      String?  // JSON: [{ name, count }]
  patternDifficultyMix String?  // JSON: { easy, medium, hard }
  patternPaperType     String?  // e.g. "MODEL_PAPER"
}

model Subject {
  id        String     @id @default(cuid())
  name      String     // e.g. "Physics", "Chemistry", "Biology", "Reasoning", "English"
  examId    String
  exam      Exam       @relation(fields: [examId], references: [id])
  chapters  Chapter[]
  createdAt DateTime   @default(now())

  @@unique([name, examId])
}

model Chapter {
  id             String    @id @default(cuid())
  name           String
  subjectId      String
  subject        Subject   @relation(fields: [subjectId], references: [id])
  // Syllabus Master status — the rule-based filter described in the roadmap
  syllabusStatus String    @default("ACTIVE") // ACTIVE | REMOVED | MODIFIED
  statusNote     String?   // e.g. "Removed in NEET 2025 syllabus revision"
  statusYear     Int?      // year the status changed
  topics         Topic[]
  questions      Question[]
  createdAt      DateTime  @default(now())

  @@unique([name, subjectId])
}

model Topic {
  id         String     @id @default(cuid())
  name       String
  chapterId  String
  chapter    Chapter    @relation(fields: [chapterId], references: [id])
  questions  Question[]
  createdAt  DateTime   @default(now())

  @@unique([name, chapterId])
}

// ---------- Institutes (light version for Phase 1 — full auth arrives Phase 6) ----------

model Institute {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  questions Question[]
  papers    Paper[]
  users     User[]
  rechargeRequests RechargeRequest[]
  razorpayTransactions RazorpayTransaction[]
  createdAt DateTime   @default(now())

  // White-label branding — shown on generated paper letterheads
  logoFilename String?
  phone        String?
  address      String?
  tagline      String?

  // Credits — balance is spent 1-per-question on finalized papers.
  creditBalance Int @default(0)
  creditHistory CreditTransaction[]

  // Trial/Demo login tracking — used for the admin's sales-outreach flow:
  // generate a dummy login, send it via WhatsApp to a prospective college,
  // record which phone number it was sent to, and see whether/how much
  // they've used it before following up.
  isTrial          Boolean @default(false)
  trialPhoneNumber String?
  trialPassword    String? // Saves the plaintext password so admin can view it later

  // Smart Exam Results & Parent Communication
  studentProfiles      StudentProfile[]
  examResults          ExamResult[]
  whatsAppMessageLogs  WhatsAppMessageLog[]
  whatsAppUsageLedgers WhatsAppUsageLedger[]
  whatsAppWalletBalance Float @default(0.0)

  // Multi-College Public Website & Portal
  website              CollegeWebsite?

  // Modular SaaS Subscriptions (Phase 2A)
  subscriptions        CollegeSubscription[]
  subscriptionHistory  SubscriptionHistory[]

  // Online Subscription Payments & Invoices (Phase 3B)
  subscriptionPayments SubscriptionPayment[]
  subscriptionInvoices SubscriptionInvoice[]
}

// ---------- Credit ledger ----------
// One row per credit change (recharge, manual admin adjustment, or a
// paper-finalization deduction), so both the admin and the institute can
// see a clear history — never just a single mutable number with no trail.
model CreditTransaction {
  id           String    @id @default(cuid())
  instituteId  String
  institute    Institute @relation(fields: [instituteId], references: [id])
  amount       Int       // positive = credit added, negative = credit spent
  reason       String    // e.g. "Trial account created", "Manual recharge", "Paper: Weekly Test 04"
  balanceAfter Int
  createdAt    DateTime  @default(now())
}

// ---------- Manual UPI (scan-and-pay) recharge requests ----------
// The institute pays the admin's UPI QR outside the app, then submits the
// reference number here. This is a REQUEST only — no credits move until an
// admin verifies the money actually arrived and approves it. That keeps
// the flow safe without any payment gateway: the app never trusts a
// self-reported payment on its own.
model RechargeRequest {
  id            String    @id @default(cuid())
  instituteId   String
  institute     Institute @relation(fields: [instituteId], references: [id])
  amountRupees  Int       // rupees the institute says they paid (1 credit = ₹1)
  creditsAsked  Int       // credits to grant on approval (kept explicit; == amountRupees today)
  upiReference  String    // UPI transaction/reference number the institute typed in
  note          String?   // optional note from the institute
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedByEmail String? // which admin acted on it
  reviewNote      String? // optional admin note (e.g. why rejected)
  reviewedAt      DateTime?
  creditTransactionId String? // links to the ledger entry created on approval
  createdAt     DateTime  @default(now())
}

// ---------- Razorpay Automated Payments ----------
// Instantly credits the institute upon successful signature verification.
model RazorpayTransaction {
  id               String    @id @default(cuid())
  instituteId      String
  institute        Institute @relation(fields: [instituteId], references: [id])
  orderId          String    @unique
  paymentId        String?   @unique
  signature        String?
  amountRupees     Int
  creditsBought    Int
  status           String    @default("CREATED") // CREATED | SUCCESS | FAILED
  createdAt        DateTime  @default(now())
  completedAt      DateTime?
}

// ---------- App-wide settings (key/value) ----------
// Small settings the admin controls, e.g. the UPI ID and QR image shown to
// institutes on the recharge page. Key/value keeps it flexible without a
// migration every time a new setting is needed.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------- Authentication ----------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    // "ADMIN" | "INSTITUTE"

  // Only set for role = INSTITUTE. An ADMIN user manages the whole
  // platform and isn't tied to a single institute.
  instituteId  String?
  institute    Institute? @relation(fields: [instituteId], references: [id])

  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  // Optional Two-Factor Authentication (TOTP, works with Google
  // Authenticator/Authy). twoFactorSecret is only set once the user has
  // confirmed setup with a valid code — never enabled from just scanning
  // the QR code, to avoid locking someone out with an unconfirmed secret.
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  // Forgot-password flow. We store a HASH of the reset token, never the
  // token itself — same principle as passwords: if the database ever
  // leaked, the stored value alone couldn't be used to reset an account.
  resetTokenHash   String?
  resetTokenExpiry DateTime?
}

// ---------- Questions ----------

model Question {
  id             String   @id @default(cuid())
  groupId        String?  // Links questions to a shared comprehension passage

  workflowState  String   @default("BANK") // DRAFT | IN_QC | BANK
  uploadBatchId  String?  // Groups questions from a single upload for preview

  questionText   String
  optionA        String
  optionB        String
  optionC        String
  optionD        String
  correctOption  String   // "A" | "B" | "C" | "D"

  // Optional worked solution/explanation. When present, an institute can
  // choose to include solutions on a generated paper (charged 1 credit
  // each, same as a question). Empty for questions that have no solution.
  solutionText   String?

  questionType   String   @default("MCQ") // MCQ | ASSERTION_REASON | MATCH_FOLLOWING | STATEMENT_I_II

  // Previous-year-question provenance. Optional — filled from the upload's
  // "ExamYear" / "ExamSource" columns when present. examYear enables
  // "how many PYQs from 2024 vs 2023" style analytics and filtering;
  // examSource keeps the full human label (e.g. "JEE Main 2025, 22 Jan
  // Shift 1") for display. Both blank for non-PYQ / freshly-authored
  // questions.
  examYear       Int?
  examSource     String?

  chapterId      String
  chapter        Chapter  @relation(fields: [chapterId], references: [id])
  topicId        String?
  topic          Topic?   @relation(fields: [topicId], references: [id])

  difficulty     String   @default("UNTAGGED") // EASY | MEDIUM | HARD | UNTAGGED
  difficultySource String @default("NONE")     // AI_SUGGESTED | HUMAN_REVIEWED | NONE

  // Ownership / sharing model (Phase 6b groundwork, added now so schema doesn't change later)
  ownerInstituteId String?
  ownerInstitute    Institute? @relation(fields: [ownerInstituteId], references: [id])
  sharedGlobally    Boolean    @default(true) // true = part of the shared Global Bank

  // Bank-source verification level
  verificationLevel String  @default("UNVERIFIED") // UNVERIFIED | AIA_VERIFIED | COMMUNITY_CONTRIBUTED

  // Reuse tracking (used later for "no-repeat in last N papers" logic)
  timesUsed      Int      @default(0)
  lastUsedAt     DateTime?

  // ---- Phase 2: AI-assisted difficulty tagging ----
  aiSuggestedDifficulty String?  // EASY | MEDIUM | HARD (AI's proposal, not final)
  aiConfidence          Float?   // 0.0 - 1.0
  aiRationale           String?  // one-line reason shown to the reviewer
  aiEngine              String?  // "CLAUDE" | "RULE_BASED"
  reviewStatus          String?  // "PENDING" | "ACCEPTED" | "OVERRIDDEN"

  // Upload provenance
  // Phase 4: Subject-specialist quality checks
  checkStatus  String?   // null (not yet checked) | PASSED | FLAGGED
  checkIssues  String?   // JSON array of issue strings, if flagged
  checkEngine  String?   // "RULE_BASED" | "CLAUDE"
  checkedAt    DateTime?

  // Diagram-based questions — filename of an uploaded image, served statically
  imageFilename String?
  optionAImage  String?
  optionBImage  String?
  optionCImage  String?
  optionDImage  String?

  sourceFileName String?
  sourceRow      Int?

  isActive       Boolean  @default(true) // soft-delete flag (e.g. superseded by a corrected question)

  papers         PaperQuestion[]
  examMappings   QuestionExamMapping[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ---------- Upload batches (audit trail) ----------

model UploadBatch {
  id             String   @id @default(cuid())
  fileName       String
  fileType       String   // xlsx | csv | docx
  totalRows      Int      @default(0)
  successCount   Int      @default(0)
  errorCount     Int      @default(0)
  errors         String?  // JSON-stringified array of row-level errors
  uploadedBy     String?  // institute slug or "AIA" for your own uploads
  createdAt      DateTime @default(now())
}

// ---------- Phase 3: Generated papers ----------

model Paper {
  id            String          @id @default(cuid())
  title         String
  instituteName String?
  instituteId   String?
  institute     Institute?      @relation(fields: [instituteId], references: [id])
  examName      String
  paperType     String          @default("DPP") // DPP | WEEKLY_TEST | GRAND_TEST | MOCK_TEST | MODEL_PAPER
  config        String          // JSON of the original generation request
  status        String          @default("DRAFT") // DRAFT | FINALIZED
  // Whether this paper was generated to include worked solutions. When
  // true, solutions are charged 1 credit each (in addition to 1 credit
  // per question) at finalize time. The answer key is always free.
  includeSolutions Boolean       @default(false)
  shortagesNote String?         // JSON: unmet requests (e.g. not enough HARD Physics)
  createdAt     DateTime        @default(now())
  finalizedAt   DateTime?
  questions     PaperQuestion[]
  cbtTests      CbtTest[]
  examResults   ExamResult[]
}

model PaperQuestion {
  id         String   @id @default(cuid())
  paperId    String
  paper      Paper    @relation(fields: [paperId], references: [id])
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  order      Int

  @@unique([paperId, questionId])
}

// ---------- Phase 3 (Digital Expansion): Online Student CBT Mode ----------

model CbtTest {
  id                     String          @id @default(cuid())
  code                   String          @unique // Short access code for WhatsApp share, e.g. "cbt-9f4a8b"
  paperId                String
  paper                  Paper           @relation(fields: [paperId], references: [id], onDelete: Cascade)
  instituteId            String?
  title                  String
  examName               String
  durationMinutes        Int             @default(60)

  // Security & Access Control
  securityMode           String          @default("STRICT_ROSTER") // STRICT_ROSTER | PIN_PROTECTED | OPEN_PRACTICE
  examPin                String?         // 4-digit PIN for PIN_PROTECTED mode
  rosterJson             String?         // Allowed roll numbers list/array in JSON
  allowSingleAttempt     Boolean         @default(true)
  tabSwitchLimit         Int             @default(3)

  // Marking Scheme
  positiveMarks          Float           @default(4.0)
  negativeMarks          Float           @default(1.0)

  // Scheduling & Results Control
  windowStartsAt         DateTime?
  windowEndsAt           DateTime?
  status                 String          @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED
  showSolutionsImmediate Boolean         @default(true)
  isResultsReleased      Boolean         @default(true)
  isPublicWebsiteVisible Boolean         @default(false)
  publicDescription      String?

  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  submissions            CbtSubmission[]
  examResults            ExamResult[]

  @@index([paperId])
  @@index([code])
}

model CbtSubmission {
  id                 String    @id @default(cuid())
  testId             String
  test               CbtTest   @relation(fields: [testId], references: [id], onDelete: Cascade)

  studentName        String
  rollNumber         String
  studentPhone       String?
  section            String?

  // Security status & anti-cheat
  isVerifiedStudent  Boolean   @default(true)
  token              String?
  tabSwitchCount     Int       @default(0)

  // Responses & Evaluation
  answersJson        String    // JSON: { [questionId]: answerValue }
  score              Float     @default(0.0)
  maxScore           Float     @default(0.0)
  correctCount       Int       @default(0)
  incorrectCount     Int       @default(0)
  unattemptedCount   Int       @default(0)
  accuracyPercentage Float     @default(0.0)
  timeSpentSeconds   Int       @default(0)

  startedAt          DateTime  @default(now())
  submittedAt        DateTime?
  status             String    @default("SUBMITTED") // IN_PROGRESS | SUBMITTED | AUTO_EXPIRED

  @@index([testId])
  @@index([rollNumber])
  @@index([testId, rollNumber])
}

model WhatsAppVerification {
  id        String   @id @default(cuid())
  phone     String   @unique
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RegistrationRequest {
  id            String   @id @default(cuid())
  fullName      String
  phone         String   @unique
  email         String
  instituteName String
  userType      String
  gbpLink       String?
  businessCardUrl String?
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt     DateTime @default(now())
}

// ---------- Multi-Exam Mapping ----------

model QuestionExamMapping {
  id                 String    @id @default(cuid())
  questionId         String
  question           Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  examId             String
  exam               Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  difficultyOverride String?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())

  @@unique([questionId, examId])
  @@index([examId])
  @@index([questionId])
}

// ============================================================================
// Phase 12 — Smart Exam Results, Performance Analytics & WhatsApp Parent Communication
// ============================================================================

model StudentProfile {
  id              String         @id @default(cuid())
  instituteId     String
  institute       Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  rollNumber      String
  fullName        String
  batchName       String         // e.g. "NEET-2026-Batch-A", "Class-12-MPC"
  section         String?        // e.g. "Section A"

  // Academic & Course Info
  classYear       String?        // e.g. "Inter 1st Year (Class 11)", "Inter 2nd Year (Class 12)", "Long Term / Repeater"
  courseTarget    String?        // e.g. "NEET (Medical)", "JEE Main & Advanced", "AP EAPCET", "TG EAPCET"
  admissionNumber String?        // Optional college admission / registration code

  // Personal & Native Demographics
  gender          String?        // "Male" | "Female" | "Other"
  photoUrl        String?        // Student profile image URL or base64 data URI
  nativePlace     String?        // Native Village / Town / City (e.g. "Tenali", "Nuzvid", "Vijayawada")
  district        String?        // District (e.g. "Krishna", "Guntur", "NTR", "Visakhapatnam")
  state           String?        // State (e.g. "Andhra Pradesh", "Telangana")
  hostelStatus    String?        // "Day Scholar" | "Hosteler / Residential"

  // Parent & Contact Details
  parentName      String?
  parentPhone     String         // Normalized E.164 (e.g. "+919876543210")
  parentRelation  String?        // "Father" | "Mother" | "Guardian"
  parentOccupation String?       // e.g. "Farmer", "Business", "Teacher", "Govt Service"
  parentEmail     String?
  studentPhone    String?        // Student's personal mobile
  address         String?        // Residential address

  results         ExamResult[]
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([instituteId, rollNumber])
  @@index([instituteId, batchName])
  @@index([instituteId, courseTarget])
  @@index([parentPhone])
}

model ExamResult {
  id                    String             @id @default(cuid())
  instituteId           String
  institute             Institute          @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  paperId               String
  paper                 Paper              @relation(fields: [paperId], references: [id], onDelete: Cascade)
  cbtTestId             String?
  cbtTest               CbtTest?           @relation(fields: [cbtTestId], references: [id], onDelete: SetNull)
  studentProfileId      String?
  studentProfile        StudentProfile?    @relation(fields: [studentProfileId], references: [id], onDelete: SetNull)

  // Student Snapshot (preserved even if student profile is edited)
  studentName           String
  rollNumber            String
  batchName             String             @default("General")
  section               String?
  parentPhone           String?

  // Exam Snapshot
  examName              String             // e.g. "NEET Grand Test - 04"
  examType              String             @default("CBT") // CBT | OFFLINE_OMR | MANUAL_ENTRY
  examDate              DateTime           @default(now())

  // Precision Marks & Metrics
  totalQuestions        Int
  attemptedQuestions    Int
  correctAnswers        Int
  incorrectAnswers      Int
  unattemptedQuestions  Int

  maxMarks              Float
  marksObtained         Float
  negativeMarksDeducted Float              @default(0.0)

  percentage            Float              // (marksObtained / maxMarks) * 100
  accuracyPercentage    Float              // (correctAnswers / attemptedQuestions) * 100

  rank                  Int                @default(1)
  totalStudents         Int                @default(1)

  academicInsight       String?            // Short, constructive insight
  status                String             @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED

  // Granular breakups
  subjectResults        ExamSubjectResult[]
  chapterResults        ExamChapterResult[]
  accessTokens          ResultAccessToken[]
  whatsappLogs          WhatsAppMessageLog[]

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([instituteId, rollNumber])
  @@index([paperId])
  @@index([batchName])
}

model ExamSubjectResult {
  id                 String     @id @default(cuid())
  resultId           String
  result             ExamResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  subjectName        String     // e.g. "Physics", "Chemistry", "Mathematics", "Biology"
  totalQuestions     Int
  attemptedQuestions Int
  correctCount       Int
  incorrectCount     Int
  unattemptedCount   Int

  maxMarks           Float
  marksObtained      Float
  accuracyPercentage Float
  percentage         Float

  @@index([resultId])
}

model ExamChapterResult {
  id                 String     @id @default(cuid())
  resultId           String
  result             ExamResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  chapterName        String
  totalQuestions     Int
  attemptedQuestions Int
  correctCount       Int
  incorrectCount     Int
  accuracyPercentage Float
  status             String     @default("AVERAGE") // STRONG (>=75%) | AVERAGE (50-74%) | WEAK (<50%)

  @@index([resultId])
}

model ResultAccessToken {
  id            String     @id @default(cuid())
  resultId      String
  result        ExamResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  token         String     @unique // 32-char unguessable cryptographic token
  viewsCount    Int        @default(0)
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  expiresAt     DateTime?
  isRevoked     Boolean    @default(false)
  createdAt     DateTime   @default(now())

  @@index([token])
}

model WhatsAppMessageLog {
  id             String      @id @default(cuid())
  instituteId    String
  institute      Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  resultId       String?
  result         ExamResult? @relation(fields: [resultId], references: [id], onDelete: SetNull)

  recipientPhone String
  templateName   String      @default("student_exam_report_v1")
  messagePayload String      // JSON string of parameters
  status         String      @default("QUEUED") // QUEUED | SENT | DELIVERED | READ | FAILED
  providerMsgId  String?
  errorMessage   String?
  retryCount     Int         @default(0)
  costInRupees   Float       @default(0.75)

  sentAt         DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime    @default(now())

  @@index([instituteId, status])
  @@index([resultId])
}

model WhatsAppUsageLedger {
  id           String    @id @default(cuid())
  instituteId  String
  institute    Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  amountRupees Float     // positive = wallet recharge, negative = message debit
  balanceAfter Float
  messageCount Int       // count of messages in this event
  description  String
  createdAt    DateTime  @default(now())

  @@index([instituteId])
}

// ==========================================
// MULTI-COLLEGE WEBSITE & PORTAL SYSTEM
// ==========================================

model CollegeWebsite {
  id                   String              @id @default(cuid())
  instituteId          String              @unique
  institute            Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  // Domain & URL Architecture
  slug                 String              @unique // matches Institute.slug
  subdomain            String?             @unique // e.g. "aims" -> aims.questionsstudio.in (future)
  customDomain         String?             @unique // e.g. "www.aimscollege.in" (future)
  domainStatus         String              @default("UNCONFIGURED") // UNCONFIGURED | PENDING_DNS | VERIFIED | ACTIVE | FAILED
  sslStatus            String              @default("NONE") // NONE | PROVISIONING | ACTIVE | EXPIRED

  // Lifecycle & Publication State
  isPublished          Boolean             @default(false)
  status               String              @default("ACTIVE") // ACTIVE | SUSPENDED | UNDER_REVIEW
  publishedAt          DateTime?
  publishedVersion     Int                 @default(0)

  // Branding & Visual Theme System
  themeTemplate        String              @default("CLASSIC_ACADEMIC") // CLASSIC_ACADEMIC | MODERN_PREMIER | TECH_EXCELLENCE
  primaryColor         String              @default("#1e40af") // Tailwind Blue 800
  secondaryColor       String              @default("#0f766e") // Tailwind Teal 700
  accentColor          String              @default("#f59e0b") // Tailwind Amber 500
  fontFamily           String              @default("Inter")
  heroTitle            String?             @default("Empowering Future Leaders & Achievers")
  heroSubtitle         String?             @default("Excellence in Academic Preparation, Competitive Ranks & Holistic Development")
  heroBannerUrl        String?
  heroCtaText          String?             @default("Apply for Admission")
  heroCtaLink          String?             @default("#admissions")

  // College Identity & Profile
  displayName          String?
  mottoTagline         String?
  estYear              Int?
  accreditation        String?             // e.g. "NAAC A+ Accredited", "CBSE Affiliated"
  campusAddress        String?
  contactPhone         String?
  contactEmail         String?
  whatsappNumber       String?
  googleMapEmbedUrl    String?

  // Social Channels
  socialFacebook       String?
  socialInstagram      String?
  socialYoutube        String?
  socialLinkedin       String?
  socialTwitter        String?

  // About Section & Institutional Highlights
  aboutTitle           String?             @default("Welcome to Our Institution")
  aboutText            String?             // Rich text/markdown
  visionText           String?
  missionText          String?
  statsCountersJson    String?             // e.g. [{"label":"Students Mentored","value":"15,000+"},{"label":"Selections in NEET/JEE","value":"3,200+"}]

  // Leadership / Director's Corner
  directorName         String?
  directorTitle        String?             @default("Director / Chairman")
  directorPhotoUrl     String?
  directorMessage      String?
  directorQualifications String?

  // SEO & OpenGraph Meta
  metaTitle            String?
  metaDescription      String?
  metaKeywords         String?
  ogImageUrl           String?

  // Modular SaaS Licensing & Subscriptions
  hasOnlineExamModule    Boolean  @default(true)
  hasRecruitmentModule   Boolean  @default(true)
  hasCrmModule           Boolean  @default(true)
  hasAdvertisingModule   Boolean  @default(false)

  // Section Visibility Toggles
  showStatsSection       Boolean  @default(true)
  showAboutSection       Boolean  @default(true)
  showDirectorSection    Boolean  @default(true)
  showWhyUsSection       Boolean  @default(true)
  showCoursesSection     Boolean  @default(true)
  showFacultySection     Boolean  @default(true)
  showMethodologySection Boolean  @default(true)
  showFacilitiesSection  Boolean  @default(true)
  showResultsSection     Boolean  @default(true)
  showAdmissionsSection  Boolean  @default(true)
  showOpenExamsSection   Boolean  @default(true)
  showCareersSection     Boolean  @default(true)
  showGallerySection     Boolean  @default(true)
  showTestimonialsSection Boolean @default(true)
  showFaqSection         Boolean  @default(true)
  showContactFormSection Boolean  @default(true)

  // Rich Configurable Long-Form Content (JSON)
  whyChooseUsJson        String?  // [{ title, description, icon }]
  methodologyStepsJson   String?  // [{ stepNumber, title, description, badge }]
  admissionProcessJson   String?  // [{ step, title, description }]
  scholarshipDetailsJson String?  // [{ name, criteria, benefit }]
  faqsJson               String?  // [{ question, answer, category }]
  promotionalBannerText  String?  // Marquee announcement ticker

  // CBT Examination Monetization & UPI Payment System
  examFee                Int                 @default(0) // Default ₹0 (Free mock tests) or ₹99, ₹199, ₹499 etc.
  upiId                  String?             // e.g. "andhrainspire@sbi"
  upiQrUrl               String?             // URL to uploaded QR image in /uploads/images
  payeeName              String?             // e.g. "Andhra Inspire Academy"
  cbtPaymentInstructions String?             // e.g. "Scan QR code & enter 12-digit UTR number"

  // Child Website Modules
  courses              CollegeCourse[]
  faculties            CollegeFaculty[]
  facilities           CollegeFacility[]
  achievements         CollegeAchievement[]
  testimonials         CollegeTestimonial[]
  galleryItems         CollegeGalleryItem[]
  enquiries            CollegeEnquiry[]
  jobPostings          CollegeJobPosting[]

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

// 1. Courses Offered
model CollegeCourse {
  id               String         @id @default(cuid())
  websiteId        String
  website          CollegeWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  courseName       String         // e.g. "NEET 2-Year Intensive Long Term"
  slug             String         // URL slug: "neet-long-term"
  category         String         // MEDICAL | ENGINEERING | FOUNDATION | DEGREE
  targetExam       String?        // NEET-UG | JEE Main | Advanced | BIPC | MPC
  duration         String?        // e.g. "2 Academic Years"
  eligibility      String?        // e.g. "Class 10 with 60% aggregate"
  description      String?
  syllabusOverview String?
  highlightsJson   String?        // JSON array of bullet points
  brochureFilename String?
  isFeatured       Boolean        @default(false)
  displayOrder     Int            @default(0)
  createdAt        DateTime       @default(now())
}

// 2. Faculty Profiles
model CollegeFaculty {
  id            String         @id @default(cuid())
  websiteId     String
  website       CollegeWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  name          String
  designation   String         // e.g. "Senior HOD & Master Lecturer"
  department    String         // Physics, Chemistry, Mathematics, Biology
  qualification String         // e.g. "M.Sc. Physics (IIT Madras), 18+ yrs exp"
  experienceYrs Int?
  photoUrl      String?
  bio           String?
  displayOrder  Int            @default(0)
  createdAt     DateTime       @default(now())
}

// 3. Infrastructure & Facilities
model CollegeFacility {
  id           String         @id @default(cuid())
  websiteId    String
  website      CollegeWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  title        String         // e.g. "Advanced Digital Physics Laboratory"
  category     String         // LAB | LIBRARY | SPORTS | HOSTEL | TRANSPORT | SMART_CLASS
  description  String?
  photoUrl     String?
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
}

// 4. Student Achievements & Hall of Fame
model CollegeAchievement {
  id           String         @id @default(cuid())
  websiteId    String
  website      CollegeWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  studentName  String?
  examOrAward  String         // e.g. "NEET 2024 AIR 42", "JEE Advanced State 1st Rank"
  rankOrScore  String?        // "AIR 42 (710/720)"
  year         Int            @default(2025)
  category     String         // ACADEMIC | COMPETITIVE_EXAM | SPORTS | OLYMPIAD
  description  String?
  photoUrl     String?
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
}

// 5. Testimonials & Reviews
model CollegeTestimonial {
  id           String         @id @default(cuid())
  websiteId    String
  website      CollegeWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  authorName   String
  authorRole   String         // e.g. "Alumni (AIIMS New Delhi, Batch 2023)" or "Parent of Sai Charan"
  quote        String
  rating       Int            @default(5)
  avatarUrl    String?
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
}

// 6. Media Gallery
model CollegeGalleryItem {
  id           String         @id @default(cuid())
  websiteId    String
  website      CollegeWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  title        String?
  category     String         @default("CAMPUS") // CAMPUS | LABS | CULTURAL | SPORTS | CONVOCATION
  mediaUrl     String
  mediaType    String         @default("IMAGE") // IMAGE | YOUTUBE_VIDEO
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
}

// 7. Admissions & General Inquiries (Private to this College)
model CollegeEnquiry {
  id                String         @id @default(cuid())
  websiteId         String
  website           CollegeWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  studentName       String
  parentName        String?
  phone             String
  email             String?
  courseOfInterest  String?
  cityOrTown        String?
  academicYear      String?
  message           String?
  status            String         @default("NEW") // NEW | CONTACTED | COUNSELED | ENROLLED | CLOSED
  adminNotes        String?

  // CBT Examination Registration & Verification
  isCbtRegistration     Boolean        @default(false)
  cbtExamName           String?
  examFee               Int            @default(0)
  paymentStatus         String         @default("FREE") // FREE | PENDING_VERIFICATION | APPROVED | REJECTED
  utrNumber             String?        // 12-digit UPI transaction reference
  paymentReceiptUrl     String?        // Receipt screenshot
  candidateRollNumber   String?        // Generated on approval
  candidatePassword     String?        // Generated on approval
  approvedAt            DateTime?
  whatsappSentAt        DateTime?

  createdAt         DateTime       @default(now())
}

// 8. Faculty Recruitment Careers
model CollegeJobPosting {
  id                     String                 @id @default(cuid())
  websiteId              String
  website                CollegeWebsite         @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  jobTitle               String                 // e.g. "Senior NEET Biology Faculty"
  department             String                 // Science / Math / Humanities / Admin
  employmentType         String                 @default("FULL_TIME") // FULL_TIME | PART_TIME | VISITING
  vacanciesCount         Int                    @default(1)
  minExperienceYrs       Int                    @default(3)
  requiredQualifications String                 // e.g. "M.Sc. / Ph.D in Botany / Zoology"
  jobDescription         String
  location               String?
  applicationDeadline    DateTime?
  isActive               Boolean                @default(true)
  applications           CollegeJobApplication[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
}

// 9. Faculty Job Applications (Private to this College)
model CollegeJobApplication {
  id              String            @id @default(cuid())
  jobPostingId    String
  jobPosting      CollegeJobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  applicantName   String
  email           String
  phone           String
  currentLocation String?
  experienceYrs   Int
  currentEmployer String?
  expectedSalary  String?
  resumeFilename  String            // Stored securely in /uploads/resumes
  coverLetter     String?
  status          String            @default("SUBMITTED") // SUBMITTED | SHORTLISTED | INTERVIEW_SCHEDULED | REJECTED | HIRED
  internalNotes   String?
  createdAt       DateTime          @default(now())
}

// ============================================================================
// MODULAR SAAS SUBSCRIPTION SYSTEM (Phase 2A)
// ============================================================================
// Manages optional monthly/annual add-on modules per college:
// 1. OMR & Answer Key Generator (₹999/mo)
// 2. Online Examination CBT (₹1,999/mo)
// 3. Dynamic College Website & Portal (₹1,499/mo)
// 4. WhatsApp Automation & Parent Communication (₹499/mo)
// 5. Complete Add-on Bundle (₹4,499/mo)
//
// NOTE: Question Paper Generation credits (₹1/Q, lifetime validity) remain
// completely independent in Institute.creditBalance & CreditTransaction.
// ============================================================================

model CollegeSubscription {
  id                  String                @id @default(cuid())
  instituteId         String
  institute           Institute             @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  
  // Module identifier: "OMR" | "CBT" | "COLLEGE_WEBSITE" | "WHATSAPP" | "COMPLETE_BUNDLE"
  moduleKey           String
  
  // Subscription state: "ACTIVE" | "EXPIRED" | "CANCELLED" | "PENDING_VERIFICATION" | "SUSPENDED"
  status              String                @default("ACTIVE")
  isActive            Boolean               @default(true)
  
  // Billing frequency: "MONTHLY" | "ANNUAL"
  billingCycle        String                @default("MONTHLY")
  
  // Historical price snapshot in Indian Rupees at time of subscription/renewal
  priceRupeesSnapshot Int
  
  // Subscription timeline
  startsAt            DateTime              @default(now())
  renewalDate         DateTime
  expiresAt           DateTime?
  autoRenew           Boolean               @default(false)
  
  // Payment tracking reference (for manual UPI / NEFT / admin verification)
  paymentMethod       String?               // "MANUAL_UPI" | "BANK_TRANSFER" | "CHEQUE" | "ADMIN_COMPLIMENTARY"
  paymentRef          String?               // UTR, transaction ID, or receipt reference
  activatedByEmail    String?               // Admin email who approved or activated
  note                String?
  
  // Audit trail
  history             SubscriptionHistory[]
  
  // Payment transactions linked to this subscription (Phase 3B)
  payments            SubscriptionPayment[]
  
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  // Each college has at most one current standing record per module/bundle
  @@unique([instituteId, moduleKey])
  @@index([instituteId])
  @@index([moduleKey, status])
  @@index([status])
}

model SubscriptionHistory {
  id                  String               @id @default(cuid())
  subscriptionId      String?
  subscription        CollegeSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  instituteId         String
  institute           Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  
  moduleKey           String               // "OMR" | "CBT" | "COLLEGE_WEBSITE" | "WHATSAPP" | "COMPLETE_BUNDLE"
  action              String               // "ACTIVATED" | "RENEWED" | "EXPIRED" | "DEACTIVATED" | "CANCELLED" | "PLAN_CHANGED"
  
  billingCycle        String               @default("MONTHLY") // "MONTHLY" | "ANNUAL"
  priceRupeesSnapshot Int                  // Price snapshot at this event
  
  periodStart         DateTime
  periodEnd           DateTime
  
  paymentMethod       String?              // "MANUAL_UPI" | "BANK_TRANSFER" | "CHEQUE" | "ADMIN_COMPLIMENTARY"
  paymentRef          String?              // UTR or transaction reference
  performedByEmail    String?              // Admin/user who performed the action
  note                String?
  
  createdAt           DateTime             @default(now())

  @@index([instituteId])
  @@index([subscriptionId])
  @@index([moduleKey])
}

// ============================================================================
// Phase 3B: Online Subscription Payments, Invoices & Webhook Audits
// ============================================================================

model SubscriptionPayment {
  id                  String               @id @default(cuid())
  instituteId         String
  institute           Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  subscriptionId      String?
  subscription        CollegeSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  // Module identifier: "OMR" | "CBT" | "COLLEGE_WEBSITE" | "WHATSAPP" | "COMPLETE_BUNDLE"
  moduleKey           String
  billingCycle        String               // "MONTHLY" | "ANNUAL"

  // Exact Monetary Breakdown in Integer Paise (₹1 = 100 paise)
  baseAmountPaise     Int                  // Base subscription catalog price in paise (e.g. 449900 for ₹4,499)
  taxAmountPaise      Int                  @default(0) // Calculated tax in paise (e.g. 80982 for ₹809.82)
  totalAmountPaise    Int                  // Total amount charged to college in paise (e.g. 530882 for ₹5,308.82)
  currency            String               @default("INR")

  // Gateway metadata
  gatewayProvider     String               @default("RAZORPAY") // "RAZORPAY" | "MANUAL_BANK"
  gatewayOrderId      String               @unique // Razorpay order_id
  gatewayPaymentId    String?              @unique // Razorpay pay_id
  gatewaySignature    String?
  paymentMethod       String?              // "upi" | "card" | "netbanking"
  gatewayFeePaise     Int?                 // Gateway transaction fee deduction in paise
  netSettledPaise     Int?                 // Net payout amount received in paise

  // Payment status: "PENDING" | "SUCCESS" | "FAILED" | "REFUNDED"
  status              String               @default("PENDING")
  paidAt              DateTime?
  failureReason       String?

  // Refund tracking (all in integer paise)
  refundReference     String?
  refundStatus        String?              // "PENDING" | "PROCESSED" | "FAILED" | null
  refundAmountPaise   Int?
  refundedAt          DateTime?

  // Idempotency & audit identifiers
  idempotencyKey      String?              @unique
  receiptNumber       String?              @unique
  requestedByEmail    String?
  notes               String?

  // Linked invoice
  invoice             SubscriptionInvoice?

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([instituteId])
  @@index([status])
  @@index([moduleKey])
  @@index([gatewayOrderId])
  @@index([createdAt])
}

model SubscriptionInvoice {
  id                  String              @id @default(cuid())
  invoiceNumber       String              @unique // e.g. "QS/2026-27/INV-0001"
  
  instituteId         String
  institute           Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  paymentId           String              @unique
  payment             SubscriptionPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  invoiceDate         DateTime            @default(now())

  // Exact Monetary Breakdown in Integer Paise
  baseAmountPaise     Int
  taxableAmountPaise  Int
  
  // Tax Rate in Integer Basis Points (100 bps = 1%, 1800 bps = 18%)
  taxRateBps          Int                 @default(0) // Configurable GST rate in basis points (e.g. 1800 for 18%)
  taxAmountPaise      Int                 @default(0) // Total tax in paise
  cgstAmountPaise     Int                 @default(0) // Intra-state CGST in paise (e.g. 900 bps)
  sgstAmountPaise     Int                 @default(0) // Intra-state SGST in paise (e.g. 900 bps)
  igstAmountPaise     Int                 @default(0) // Inter-state IGST in paise (e.g. 1800 bps)
  totalAmountPaise    Int                 // Gross invoice total in paise

  // Status: "ISSUED" | "PAID" | "VOID" | "REFUNDED"
  status              String              @default("ISSUED")

  // Tax compliance & PDF reference (neutral accounting classification)
  sacCode             String?
  collegeGstin        String?
  billingAddress      String?
  pdfPath             String?

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([instituteId])
  @@index([invoiceNumber])
  @@index([invoiceDate])
  @@index([status])
}

model PaymentWebhookLog {
  id                  String              @id @default(cuid())
  gatewayProvider     String              @default("RAZORPAY")
  eventId             String              @unique // Gateway event ID (e.g. x-razorpay-event-id)
  eventType           String              // e.g. "payment.captured", "payment.failed", "refund.processed"

  gatewayOrderId      String?
  gatewayPaymentId    String?

  // Processing state: "RECEIVED" | "PROCESSED" | "FAILED" | "IGNORED"
  processingStatus    String              @default("RECEIVED")
  receivedAt          DateTime            @default(now())
  processedAt         DateTime?
  errorDetails        String?

  // Redacted payload for audit and dispute resolution
  payload             String

  createdAt           DateTime            @default(now())

  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
  @@index([processingStatus])
  @@index([receivedAt])
}



